PS4 9.00 host - ESP32 core lwIP patch (NTP NAPT DNAT + SNTP failover)

Enables lwIP NAPT plus a narrow DNAT receive hook used by ps4-900u-host to
redirect GoldHEN's hard-coded NTP server (216.239.35.0:123) to the ESP32, and
shortens the SNTP failover timeout. Nothing else in the network path is touched.

Base (the patch is generated against this exact state):
  ESP-IDF         : v4.4  (commit 8153bfe "versions: Update version to 4.4.0")
  lwip submodule  : 2749568f "add function for deinit lwip timers"

Build flags (sdkconfig / sdkconfig.defaults):
  CONFIG_LWIP_IPV4_NAPT=y
  CONFIG_LWIP_IP_FORWARD=n
  CONFIG_LWIP_L2_TO_L3_COPY=y

This file contains TWO hunks; apply each in the directory listed in its marker:

  [1/2] in the esp-idf repo root        -> Kconfig, lwipopts.h
  [2/2] in components/lwip/lwip         -> lwip source (ip4.c, ip4_napt.c, sntp.c, headers)


# ============================================================================

# [1/2] Apply in the ESP-IDF repo root (git apply, or: patch -p1)

# ============================================================================

diff --git a/components/lwip/Kconfig b/components/lwip/Kconfig
index e229f22..644a963 100644
--- a/components/lwip/Kconfig
+++ b/components/lwip/Kconfig
@@ -178,8 +178,6 @@ menu "LWIP"
 
     config LWIP_IPV4_NAPT
         bool "Enable NAT (new/experimental)"
-        depends on LWIP_IP_FORWARD
-        select LWIP_L2_TO_L3_COPY
         default n
         help
             Enabling this option allows Network Address and Port Translation.
diff --git a/components/lwip/port/esp32/include/lwipopts.h b/components/lwip/port/esp32/include/lwipopts.h
index 47215e9..532d9bf 100644
--- a/components/lwip/port/esp32/include/lwipopts.h
+++ b/components/lwip/port/esp32/include/lwipopts.h
@@ -1062,6 +1062,10 @@
 #define SNTP_MAX_SERVERS                CONFIG_LWIP_SNTP_MAX_SERVERS
 #endif // CONFIG_LWIP_SNTP_MAX_SERVERS
 
+// Speed up SNTP server failover: wait only 5s for a reply before trying the
+// next server (stock 15s makes a blocked primary stall the clock sync ~30s).
+#define SNTP_RECV_TIMEOUT               5000
+
 #ifdef CONFIG_LWIP_DHCP_GET_NTP_SRV
 #define LWIP_DHCP_GET_NTP_SRV           CONFIG_LWIP_DHCP_GET_NTP_SRV
 #endif // CONFIG_LWIP_DHCP_GET_NTP_SRV


