  @@ -684,6 +686,27 @@ ip_napt_recv(struct pbuf *p, struct ip_hdr *iphdr)
  +/* Rewrite the source of replies from a portmapped local service back to the
  + * mapped external address/port (inverse of the DNAT performed in
  + * ip_napt_recv), so a client that queried a hardcoded external server address
  + * accepts the response. */
  +void
  +ip_napt_output(struct pbuf *p, struct ip_hdr *iphdr)
  +{
  +#if LWIP_UDP
  +  if (IPH_PROTO(iphdr) == IP_PROTO_UDP && p->len >= IPH_HL(iphdr) * 4 + sizeof(struct udp_hdr)) {
  +    struct udp_hdr *udphdr = (struct udp_hdr *)((u8_t *)iphdr + IPH_HL(iphdr) * 4);
  +    struct portmap_table *m = ip_portmap_find_dest(IP_PROTO_UDP, udphdr->src, iphdr->src.addr);
  +    if (m) {
  +      if (m->mport != udphdr->src)
  +        ip_napt_modify_port_udp(udphdr, 0, m->mport);
  +      ip_napt_modify_addr_udp(udphdr, &iphdr->src, m->maddr);
  +      ip_napt_modify_addr(iphdr, &iphdr->src, m->maddr);
  +    }
  +  }
  +#endif /* LWIP_UDP */
  +}
